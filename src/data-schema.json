{
    "$id": "h...",
    "$schema": "https://json-schema.org/draft-07/schema",
    "definitions": {
        "rewardCommand": {
            "properties": {
                "rewardTime": {
                    "type": "number",
                    "minimum": 0
                },
                "rewardPosition": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1
                }
            }
        },

        "TrackingProperties": {
            "type": "object",
            "properties": {
                "cropSourcePoints": {
                    "type": "object",
                    "description": "Four corner points (clockwise from top-left) of the area used for immobility tracking.",
                    "properties": {
                        "points": {
                            "type": "array",
                            "items": { "$ref": "#/definitions/point2d" },
                            "minItems": 4,
                            "maxItems": 4
                        }
                    },
                    "required": [ "points" ]
                },
                "minArea": { "type": "number", "default": 900 },
                "immobilityAlert": { "$ref": "#/definitions/ImmobilityAlertSettings" }
            }
        },
        "ImmobilityAlertSettings": {
            "type": "object",
            "properties": {
                "radius": { "type": "number", "default": 20 },
                "alertAfterMinutes": { "type": "number", "default": 90 },
                "sendTestOnStart": { "type": "boolean", "default": true },
                "notifyWhenMovingAgain": { "type": "boolean", "default": true },
                "rigName": { "type": "string", "default": "Hypnose rig" },
                "webhookUrlFile": { "type": "string", "default": "slack_webhook.txt" }
            }
        },

        "olfactometerStateCommand": {
            "properties": {
                "name": {
                    "description": "The alias of this olfactometer command",
                    "type": "string"
                },
                "flowEnabledO0": {
                    "description": "Boolean specifying whether to enable airflow across all channels in olfactometer 0",
                    "type": "boolean",
                    "default": "True"
                },
                "flowEnabledO1": {
                    "description": "Boolean specifying whether to enable airflow across all channels in olfactometer 1",
                    "type": "boolean",
                    "default": "True"
                },
                "valvesOpenO0": {
                    "items": {
                        "minimum": 0,
                        "maximum": 3,
                        "type": "integer"
                    },
                    "type": "array"
                },
                "valvesOpenO1": {
                    "items": {
                        "minimum": 0,
                        "maximum": 3,
                        "type": "integer"
                    },
                    "type": "array"
                },
                "endValvesOpenO0": {
                    "items": {
                        "minimum": 0,
                        "maximum": 1,
                        "type": "integer"
                    },
                    "type": "array"
                },
                "endValvesOpenO1": {
                    "items": {
                        "minimum": 0,
                        "maximum": 1,
                        "type": "integer"
                    },
                    "type": "array"
                },
                "targetFlowO0": {
                    "description": "The target flow rates of the 5 flow channels on olfactometer 0 in ml/min. Range for the odor channels is 0-100ml/min and 0-1000ml/min for the carrier line.",
                    "items": {
                        "minimum": 0,
                        "maximum": 1000,
                        "type": "number"
                    },
                    "type": "array",
                    "minItems": 5,
                    "maxItems": 5
                },
                "targetFlowO1": {
                    "description": "The target flow rates of the 5 flow channels on olfactometer 1 in ml/min. Range for the odor channels is 0-100ml/min and 0-1000ml/min for the carrier line.",
                    "items": {
                        "minimum": 0,
                        "maximum": 1000,
                        "type": "number"
                    },
                    "type": "array",
                    "minItems": 5,
                    "maxItems": 5
                }
            }
        },
        "point2d": {
            "type": "object",
            "properties": {
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                }
            },
            "required": [
                "x",
                "y"
            ]
        },
        "taskAccessWindow": {
            "description": "A daily time window on the 24 h clock, open from start (inclusive) to end (exclusive). If end is earlier than start, the window runs past midnight (e.g. 22:00:00 to 02:00:00).",
            "type": "object",
            "properties": {
                "start": {
                    "description": "Time of day the window opens, as HH:mm:ss (quoted).",
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
                },
                "end": {
                    "description": "Time of day the window closes, as HH:mm:ss (quoted). Must differ from start; a window with equal start and end never opens.",
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
                }
            },
            "required": [
                "start",
                "end"
            ]
        }
    },
    "properties": {
        "metadata": {
            "properties": {
                "animalId": {
                    "default": "",
                    "type": "string"
                    },
                "rootPath": {
                    "default": "",
                    "type": "string"
                },
                "minimumSampleTime": {
                    "description": "Minimum amount of time in seconds a subject must sample the port to initiate a trial.",
                    "default": 0.1,
                    "type": "number"
                },
                "rewardTime": {
                    "description": "Time in seconds to deliver 1uL of rewards",
                    "default": 0.1,
                    "type": "number"
                },
                "loggingRootPath": {
                    "description": "The local root folder to save data for this session",
                    "default": "",
                    "type": "string"
                },
                "initialSequence": {
                    "description": "Path to the initial sequence .yml file to run",
                    "type": "string"
                },
                "rewardBecomeAvailableTime": {
                    "description": "Time in seconds after leaving odour port following rewared odour that it becomes available",
                    "default": 1.5,
                    "type": "number"
                },
                "eegRecordingEnabled": {
                    "description": "Boolean specifying whether to enable EEG recording for this session",
                    "default": false,
                    "type": "boolean"
                },
                "maximumRewardsAvailable": {
                    "description": "Maximum number of rewards available for this session.",
                    "default": 200,
                    "type": "integer"
                }
            }
        },
        "shortcutKeys": {
            "properties": {
                "endSessionKey": {
                    "description": "The key to press to end the session",
                    "default": "Ctrl+1",
                    "type": "string"
                },
                "startOlfactometerPurgeKey": {
                    "description": "The key to press to start the olfactometer purge",
                    "default": "Shift+1",
                    "type": "string"    
                },
                "startCamera": {
                    "description": "The key to press to start the camera",
                    "default": "S+1",
                    "type": "string"
                },
                "pulse1Key": {
                    "description": "The key to press to trigger pulse 1",
                    "default": "Ctrl+2",
                    "type": "string"
                },
                "pulse2Key": {
                    "description": "The key to press to trigger pulse 2",
                    "default": "Ctrl+3",
                    "type": "string"
                }
            }
        },
        "hardwarePorts": {
            "properties": {
                "behaviorBoard": {
                    "description": "The COM port for the behavior board",
                    "default": "Default",
                    "type": "string"
                },
                "olfactometer0": {
                    "description": "The COM port for the first olfactometer",
                    "type": "string"
                },
                "olfactometer1": {
                    "description": "The COM port for the second olfactometer",
                    "type": "string"
                }
            }
        },
        "eegProperties": {
            "properties": {
                "deviceName": {
                    "description": "The ID of the EEG device to use for this rig.",
                    "default": "Default",
                    "type": "string"
                },
                "streamName": {
                    "description": "The names of the EEG streams to use for this rig.",
                    "default": "EEG1,EEG2,EMG",
                    "type": "string"
                }
            }
        },
        "cameraProperties": {
            "properties": {
                "cameraId": {
                    "default": 24282618,
                    "type": "string",
                    "description": "The camera ID to use for this rig."
                },
                "frameRate": {
                    "default": 60,
                    "type": "number",
                    "description": "The target camera frame rate in frames per second."
                },
                "binning": {
                    "default": 1,
                    "type": "number",
                    "description": "The camera binning factor."
                },
                "exposure": {
                    "default": 19000,
                    "type": "number",
                    "description": "The frame exposure in microseconds."
                },
                "gain": {
                    "default": 0,
                    "type": "number",
                    "description": "the gain of the camera sensor."
                },
                "threshold": {
                    "default": 15,
                    "type": "number",
                    "description": "The threshold value for detecting an object against the normalised background of the ROI."
                },
                "binaryThreshold": {
                    "default": 110,
                    "type": "number",
                    "description": "The threshold value for detecting an object against the normalised background of the ROI."
                },
                "roiSourcePoints": {
                    "type": "object",
                    "description": "The four source points in the camera image that define the region of interest (in clockwise order starting from top-left).",
                    "properties": {
                        "points": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/point2d"
                            },
                            "minItems": 4,
                            "maxItems": 4
                        }
                    },
                    "required": [
                        "points"
                    ]
                }
            },
            "required": [ "roiSourcePoints"]
        },
        "lightCycle": {
            "description": "Daily light schedule for the LED driven by digital output DO2 on the behavior board. Times are on the 24 h clock as HH:mm:ss (quoted). Leave this section out to disable light control on this rig.",
            "properties": {
                "dawnStart": {
                    "description": "Time of day the light starts fading in. Full brightness is reached at dawnStart + dawnDuration.",
                    "default": "09:00:00",
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
                },
                "dawnDuration": {
                    "description": "Length of the fade-in. Use 00:00:00 to switch on instantly. Must end before duskStart.",
                    "default": "01:00:00",
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
                },
                "duskStart": {
                    "description": "Time of day the light starts fading out. Fully off at duskStart + duskDuration.",
                    "default": "21:00:00",
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
                },
                "duskDuration": {
                    "description": "Length of the fade-out. Use 00:00:00 to switch off instantly. Must end before the next dawnStart.",
                    "default": "01:00:00",
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
                },
                "pwmFrequency": {
                    "description": "PWM frequency on DO2 during fades, in Hz (1-10000).",
                    "default": 1000,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                }
            }
        },
        "taskAccess": {
            "description": "Daily time windows during which the task is available, checked against the PC clock once per second. New initiations stop 60 s before a window ends: a trial the animal has already initiated runs on, but no new trial or re-initiation can start, and a trial still waiting for initiation is stopped with its LED off. When the window ends, anything still running is stopped, all nose-poke port LEDs (DOPort0-2) are off and the olfactometer is set to Default; logging and the camera keep running. A window of 60 s or less never opens for initiation. Leave this section out (or empty) to make the task available all day.",
            "type": "array",
            "items": {
                "$ref": "#/definitions/taskAccessWindow"
            }
        },

        "trackingProperties": { "$ref": "#/definitions/TrackingProperties" },

        "olfactometerCommands": {
            "items": {
                "$ref": "#/definitions/olfactometerStateCommand"
            },
            "type": "array"
        }
    },
    "title": "HypnoseSession",
    "type": "object"
}